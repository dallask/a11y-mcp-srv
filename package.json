{
  "name": "@dallask/a11y-mcp-srv",
  "version": "2.1.0",
  "description": "MCP server for accessibility auditing with export, filter, aggregation, and visualization tools",
  "main": "dist/server.js",
  "type": "module",
  "bin": {
    "accessibility-mcp-server": "bin/server.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "npm run build && vitest run tests/e2e",
    "test:coverage": "vitest run --coverage",
    "release": "semantic-release",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "accessibility",
    "a11y",
    "audit",
    "wcag",
    "export",
    "csv",
    "excel",
    "dashboard"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dallask/a11y-mcp-srv.git",
    "directory": "a11y-mcp-srv"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.5.0",
    "accessibility-checker": "^4.0.9",
    "axe-core": "^4.11.0",
    "playwright": "^1.40.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^9.0.4",
    "@semantic-release/npm": "^11.0.0",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^4.1.0",
    "semantic-release": "^24.2.0",
    "tsx": "^4.7.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist/",
    "bin/",
    "README.md",
    "package.json",
    "LICENSE",
    "NOTICE"
  ]
}
